<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.silent.chief</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/silent/Desktop/silent graph/trading-agent 3/agents/chief.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/silent/Desktop/silent graph/trading-agent 3</string>

  <!-- 6:00 AM (pre-open, after SAGE 5 AM) and 4:30 PM (post-close) Arizona MST (UTC-7) -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key>   <integer>6</integer>
      <key>Minute</key> <integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key>   <integer>16</integer>
      <key>Minute</key> <integer>30</integer>
    </dict>
  </array>

  <key>KeepAlive</key>
  <false/>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/silent/Desktop/silent graph/trading-agent 3/logs/chief.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/silent/Desktop/silent graph/trading-agent 3/logs/chief_error.log</string>

  <key>Nice</key>
  <integer>10</integer>
</dict>
</plist>
