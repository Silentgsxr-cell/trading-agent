<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.silent.devagent</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Library/Developer/CommandLineTools/usr/bin/python3</string>
        <string>/Users/silent/Desktop/silent graph/trading-agent 2/utils/dev_agent.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/silent/Desktop/silent graph/trading-agent 2</string>

    <!--
      Run at 5:00 AM and 5:30 PM Arizona MST (UTC-7, no daylight saving).
      5:00 AM AZ = 12:00 UTC
      5:30 PM AZ = 00:30 UTC (next day)
      launchd uses LOCAL time, so these are local clock values.
    -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>   <integer>5</integer>
            <key>Minute</key> <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>   <integer>17</integer>
            <key>Minute</key> <integer>30</integer>
        </dict>
    </array>

    <!-- One-shot: run and exit. Not a persistent daemon. -->
    <key>KeepAlive</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/silent/Desktop/silent graph/trading-agent 2/logs/dev_agent.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/silent/Desktop/silent graph/trading-agent 2/logs/dev_agent.log</string>

    <!-- Low priority — never compete with runner.py -->
    <key>Nice</key>
    <integer>10</integer>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <key>PYTHONDONTWRITEBYTECODE</key>
        <string>1</string>
    </dict>
</dict>
</plist>
