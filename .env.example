# ClawOps — environment variables
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# Legacy single webhook (still used by watchdog/dev_agent until Step 9 cleanup)
DISCORD_WEBHOOK_URL=your_webhook_url_here
DISCORD_BOT_TOKEN=your_bot_token_here

# Required for the autonomous Dev Agent and Suggestion Agent (utils/dev_agent.py, utils/suggestion_agent.py)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Discord channel webhooks — 6 dedicated channels (add these to .env manually)
# agent_brain.py and suggestion_agent.py route to these.
# Step 9 of the suggestion layer will wire all existing utils to use these.
DISCORD_MORNING_BRIEF_WEBHOOK=
DISCORD_TRADE_ALERTS_WEBHOOK=
DISCORD_WATCHDOG_WEBHOOK=
DISCORD_DEV_AGENT_WEBHOOK=
DISCORD_SUGGESTIONS_WEBHOOK=
DISCORD_AGENT_ACTIVITY_WEBHOOK=

# Required for Webull paper trading integration (not yet built)
# WEBULL_APP_KEY=your_webull_app_key_here
# WEBULL_APP_SECRET=your_webull_app_secret_here
# WEBULL_DEVICE_ID=your_webull_device_id_here
# WEBULL_TRADE_TOKEN=your_webull_trade_token_here
